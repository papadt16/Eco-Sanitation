# ============================================================================
# EcoSanitation Node Dashboard — environment variables
# Copy this file to ".env" for local development and fill in real values.
# In production, set the same keys under Vercel → Project → Settings →
# Environment Variables. Never commit your actual ".env" file.
# ============================================================================

# --- Firebase Authentication (Admin email/password) -------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# --- MQTT Broker (HiveMQ Cloud or any MQTT-over-WebSockets broker) ----------
# Use the WebSocket Secure (wss) endpoint, NOT the raw TCP port.
# Example HiveMQ Cloud format: wss://<cluster-id>.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_URL=wss://your-broker-host:8884/mqtt
VITE_MQTT_USERNAME=your_mqtt_username
VITE_MQTT_PASSWORD=your_mqtt_password

# Topic the ESP32 publishes telemetry to. Use a wildcard (+) to receive
# from every manhole node, e.g. "sewage/nodes/+/telemetry"
VITE_MQTT_TOPIC=sewage/nodes/+/telemetry
